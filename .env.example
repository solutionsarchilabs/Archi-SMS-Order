SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders,write_orders,read_customers,read_fulfillments
SHOPIFY_APP_URL=
# Vercel cannot reach db.*.supabase.co (IPv6). Use the IPv4 pooler:
# DATABASE_URL = transaction pooler :6543 ?pgbouncer=true
# DIRECT_URL   = session pooler :5432 (same host, no pgbouncer flag)
DATABASE_URL=
DIRECT_URL=
# Optional: fuller AI chat (OpenAI or Groq). Without this, the guided assistant still sets the app up.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=
